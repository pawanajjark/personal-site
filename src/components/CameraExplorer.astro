---
import { Image } from 'astro:assets';
import { cameraAlbums } from '../data/camera-photos';
---

<camera-explorer>
  <aside class="camera-note" aria-label="Explore photos from my Sony Cybershot">
    <div class="camera-control" style="--open: 0">
      <div class="camera-object">
        <div class="camera-flip">
        <div class="camera-front">
        <div class="camera-top" aria-hidden="true"><span class="shutter"></span><span class="zoom-lever"><i>W</i><i>T</i></span><span class="mode-switch"></span><span class="power-label">POWER</span><span class="power-light"></span><span class="top-model">DSC-T20</span></div>
        <div class="camera-body">
          <div class="lens-plate" aria-hidden="true">
            <span class="zeiss">Carl Zeiss<small>Vario-Tessar</small></span>
            <span class="flash"></span><span class="focus-lamp"></span><span class="mic"></span><span class="screw s1"></span><span class="screw s2"></span><span class="screw s3"></span><span class="screw s4"></span><span class="steady">SteadyShot</span>
            <span class="zoom-label">3× OPTICAL ZOOM</span>
            <span class="lens-housing"><span class="lens-ring"><span class="lens-knurl"></span><span class="lens-glass"></span></span></span>
          </div>
          <span class="body-label" aria-hidden="true">8.1 MEGA PIXELS</span>
          <span class="speaker" aria-hidden="true"></span><span class="strap-lug" aria-hidden="true"></span><span class="spec" aria-hidden="true">f=6.3-18.9mm 1:3.5-4.4 · MADE IN JAPAN</span>
          <button class="lens-cover" type="button" aria-controls="camera-back" aria-label="Slide the cover down or press to switch on my Sony Cybershot and explore photos">
            <span class="cover-edge" aria-hidden="true"></span><span class="sony-logo" aria-hidden="true">SONY</span><span class="cybershot-logo" aria-hidden="true">Cyber-shot</span><span class="cover-grip" aria-hidden="true"></span><span class="cover-rail" aria-hidden="true"></span><span class="cover-ridges" aria-hidden="true"></span><span class="cover-zeiss" aria-hidden="true">Carl Zeiss<small>Vario-Tessar</small></span><span class="cover-mp" aria-hidden="true">8.1<small>MEGA PIXELS</small></span><span class="cover-screw cs1" aria-hidden="true"></span><span class="cover-screw cs2" aria-hidden="true"></span>
          </button>
        </div>
        </div>
        <div class="camera-back" id="camera-back" role="group" aria-label="Photos on the back of my Sony Cybershot" inert>
          <div class="lcd">
            {cameraAlbums.map(album => <div class="lcd-album" data-title={album.title} data-shuffle={album.id === 'people' || undefined} hidden>
              {album.photos.map(photo => <figure hidden><Image src={photo.src} alt={photo.alt} width={640} widths={[640, 1600]} sizes="640px" loading="lazy" /><figcaption>{photo.title}</figcaption></figure>)}
            </div>)}
            <div class="lcd-menu">
              <p>Select album</p>
              {cameraAlbums.map((album, n) => <button type="button" data-pick={n}><span>{album.title}</span><small>{album.photos.length}</small></button>)}
            </div>
            <div class="osd" aria-live="polite"><span data-osd-album></span><span data-osd-count></span></div>
            <button class="lcd-zoom" type="button" data-zoom aria-label="Enlarge photo" aria-controls="camera-photo-dialog"></button>
            <span class="lcd-glare" aria-hidden="true"></span>
          </div>
          <div class="back-controls">
            <div class="dpad">
              <button type="button" data-nav="up" aria-label="Up">▲</button>
              <button type="button" data-nav="left" aria-label="Previous photo">◀</button>
              <button type="button" class="dpad-center" data-nav="ok" aria-label="Select">OK</button>
              <button type="button" data-nav="right" aria-label="Next photo">▶</button>
              <button type="button" data-nav="down" aria-label="Down">▼</button>
            </div>
            <button class="menu-btn" type="button" data-nav="menu">Menu</button>
            <button class="flip-back" type="button" data-camera-close>Flip back</button>
          </div>
          <span class="back-print" aria-hidden="true">Cyber-shot</span>
        </div>
        </div>
        <input class="cover-slider" type="range" min="0" max="100" value="0" step="1" aria-label="Slide the lens cover down to explore photos" aria-controls="camera-back" aria-orientation="vertical" />
      </div>
      <p class="camera-model">My Sony Cybershot<span>DSC-T20 · 2007</span></p>
      <button class="explore-hint" type="button" data-camera-open aria-controls="camera-back"><svg class="hint-arrow" viewBox="0 0 80 64" fill="none" aria-hidden="true"><path d="M68 8C73 37 43 59 10 37M10 37L13 52M10 37L26 36" /></svg><span>Explore my photos</span></button>
    </div>
  </aside>

  <dialog id="camera-photo-dialog" aria-label="Enlarged photo">
    <img alt="" />
    <p class="zoom-caption"></p>
    <button class="zoom-nav zoom-prev" type="button" data-zoom-step="left" aria-label="Previous photo">◀</button>
    <button class="zoom-nav zoom-next" type="button" data-zoom-step="right" aria-label="Next photo">▶</button>
    <button class="zoom-close" type="button" data-zoom-close aria-label="Close enlarged photo">✕</button>
  </dialog>

</camera-explorer>

<script>
  document.querySelectorAll('camera-explorer').forEach(explorer => {
    const slider = explorer.querySelector<HTMLInputElement>('.cover-slider');
    const control = explorer.querySelector<HTMLElement>('.camera-control');
    const cover = explorer.querySelector<HTMLButtonElement>('.lens-cover');
    const body = explorer.querySelector<HTMLElement>('.camera-body');
    const front = explorer.querySelector<HTMLElement>('.camera-front');
    const back = explorer.querySelector<HTMLElement>('.camera-back');
    if (!slider || !control || !cover || !body || !front || !back) return;
    const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const albums = [...back.querySelectorAll<HTMLElement>('.lcd-album')];
    const picks = [...back.querySelectorAll<HTMLElement>('[data-pick]')];
    const menu = back.querySelector<HTMLElement>('.lcd-menu')!;
    const osd = back.querySelector<HTMLElement>('.osd')!;
    const osdAlbum = back.querySelector<HTMLElement>('[data-osd-album]')!;
    const osdCount = back.querySelector<HTMLElement>('[data-osd-count]')!;
    const zoom = explorer.querySelector<HTMLDialogElement>('#camera-photo-dialog')!;
    const zoomImg = zoom.querySelector('img')!;
    const zoomCaption = zoom.querySelector<HTMLElement>('.zoom-caption')!;
    const zoomBtn = back.querySelector<HTMLElement>('[data-zoom]')!;
    const syncZoom = () => {
      const fig = albums[album].children[photo];
      const img = fig.querySelector('img')!;
      zoomImg.sizes = '(min-width: 1000px) 900px, 92vw';
      zoomImg.srcset = img.srcset;
      zoomImg.src = img.currentSrc || img.src;
      zoomImg.alt = img.alt;
      zoomCaption.textContent = `${fig.querySelector('figcaption')?.textContent ?? ''} · ${photo + 1}/${albums[album].children.length}`;
    };
    let album = 0, photo = 0, inMenu = true;
    // Fresh random order each time an album marked data-shuffle is entered.
    const enter = (n: number) => {
      album = n; photo = 0; inMenu = false;
      const el = albums[n];
      if (el.dataset.shuffle === undefined) return;
      const figs = [...el.children];
      for (let i = figs.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [figs[i], figs[j]] = [figs[j], figs[i]]; }
      el.append(...figs);
    };
    const show = () => {
      menu.hidden = !inMenu;
      osd.hidden = inMenu;
      zoomBtn.hidden = inMenu;
      picks.forEach((el, n) => el.setAttribute('aria-current', String(n === album)));
      albums.forEach((el, n) => {
        el.hidden = inMenu || n !== album;
        if (n === album) [...el.children].forEach((fig, k) => (fig as HTMLElement).hidden = k !== photo);
      });
      osdAlbum.textContent = albums[album].dataset.title ?? '';
      osdCount.textContent = `${photo + 1}/${albums[album].children.length}`;
      if (zoom.open) syncZoom();
    };
    const step = (dir: string) => {
      const count = albums[album].children.length;
      const wrap = (n: number, max: number) => (n + max) % max;
      if (dir === 'menu') inMenu = true;
      else if (inMenu) {
        if (dir === 'up' || dir === 'down') album = wrap(album + (dir === 'down' ? 1 : -1), albums.length);
        else if (dir === 'ok' || dir === 'right') enter(album);
      } else if (dir === 'left' || dir === 'right') photo = wrap(photo + (dir === 'right' ? 1 : -1), count);
      else if (dir === 'up' || dir === 'down') enter(wrap(album + (dir === 'up' ? 1 : -1), albums.length));
      show();
    };
    picks.forEach((el, n) => el.addEventListener('click', () => { enter(n); show(); }));
    back.querySelectorAll<HTMLElement>('[data-nav]').forEach(button => button.addEventListener('click', () => step(button.dataset.nav!)));
    back.addEventListener('keydown', event => {
      const dir = { ArrowLeft: 'left', ArrowRight: 'right', ArrowUp: 'up', ArrowDown: 'down' }[event.key];
      if (dir) { event.preventDefault(); step(dir); }
      else if (event.key === 'Escape') close();
      else if (event.key === 'Enter' && !(event.target as HTMLElement).closest('button')) step('ok');
    });
    zoomBtn.addEventListener('click', () => { syncZoom(); zoom.showModal(); });
    zoom.querySelectorAll<HTMLElement>('[data-zoom-step]').forEach(b => b.addEventListener('click', () => step(b.dataset.zoomStep!)));
    zoom.querySelector('[data-zoom-close]')?.addEventListener('click', () => zoom.close());
    zoom.addEventListener('click', event => { if (event.target === zoom) zoom.close(); });
    zoom.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft') step('left');
      else if (event.key === 'ArrowRight') step('right');
    });
    show();

    let opened = false;
    let dragStart: number | undefined;
    let startValue = 0;
    let moved = false;
    let ignoreClick = false;
    const flipTime = () => (reduced() ? 0 : 700);
    const setPosition = (value: number) => {
      slider.value = String(Math.max(0, Math.min(100, value)));
      control.style.setProperty('--open', String(Number(slider.value) / 100));
    };
    const setFlipped = (on: boolean) => {
      control.dataset.flipped = String(on);
      front.inert = on;
      back.inert = !on;
    };
    const open = () => {
      if (opened) return;
      opened = true;
      setPosition(100);
      window.setTimeout(() => {
        setFlipped(true);
        window.setTimeout(() => back.querySelector<HTMLElement>('[data-camera-close]')?.focus(), flipTime());
      }, (reduced() ? 0 : 300) + 250);
    };
    const close = () => {
      if (!opened) return;
      setFlipped(false);
      inMenu = true; show();
      window.setTimeout(() => { opened = false; setPosition(0); cover.focus(); }, flipTime() / 2);
    };
    cover.addEventListener('pointerdown', event => {
      if (event.button !== 0 || opened) return;
      dragStart = event.clientY;
      startValue = Number(slider.value);
      moved = false;
      control.dataset.dragging = 'true';
      cover.setPointerCapture(event.pointerId);
    });
    cover.addEventListener('pointermove', event => {
      if (dragStart === undefined) return;
      const distance = event.clientY - dragStart;
      if (Math.abs(distance) > 4) moved = true;
      setPosition(startValue + distance / (body.clientHeight * 0.30) * 100);
    });
    cover.addEventListener('pointerup', () => {
      if (dragStart === undefined) return;
      dragStart = undefined;
      control.dataset.dragging = 'false';
      ignoreClick = moved;
      if (moved && Number(slider.value) >= 65) open();
      else if (moved) setPosition(0);
    });
    cover.addEventListener('pointercancel', () => {
      dragStart = undefined;
      control.dataset.dragging = 'false';
      setPosition(0);
    });
    cover.addEventListener('click', event => {
      if (ignoreClick && event.detail !== 0) { ignoreClick = false; return; }
      ignoreClick = false;
      open();
    });
    explorer.querySelectorAll('[data-camera-open]').forEach(button => button.addEventListener('click', open));
    explorer.querySelector('[data-camera-close]')?.addEventListener('click', close);
    slider.addEventListener('input', () => {
      setPosition(Number(slider.value));
      if (Number(slider.value) >= 90) open();
    });
    slider.addEventListener('change', () => {
      if (opened) return;
      setPosition(0);
    });
  });
</script>

<style>
  camera-explorer { display: block; }
  .camera-note { width: 400px; max-width: calc(100% - 16px); margin: 60px auto 44px; }
  .camera-control { position: relative; text-align: center; }
  button { font: inherit; cursor: pointer; }
  button:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  .camera-object { position: relative; isolation: isolate; filter: drop-shadow(0 16px 14px rgb(0 0 0 / .18)); }
  .camera-top { position: absolute; top: -7px; left: 3%; width: 94%; height: 18px; border: 1px solid #828286; border-radius: 12px 12px 0 0; background: linear-gradient(#d4d4d6, #77777b 45%, #c2c2c5 65%, #5d5d60); }
  .shutter { position: absolute; left: 9%; top: -5px; width: 50px; height: 10px; background: linear-gradient(#eee, #9b9b9d 60%, #ddd); border: 1px solid #68686b; border-radius: 50%; box-shadow: 0 1px 1px #ffffffa0; }
  .power-label { position: absolute; left: 38%; top: 0; font: 6px/10px Arial, sans-serif; letter-spacing: 1px; color: #38383c; }
  .power-light { position: absolute; left: 53%; top: 3px; width: 5px; height: 3px; background: #a6e578; opacity: calc(.25 + var(--open) * .75); border-radius: 2px; }
  .top-model { position: absolute; right: 9%; top: 0; font: 6px/10px Arial, sans-serif; color: #555; letter-spacing: .8px; }
  .camera-body { position: relative; aspect-ratio: 1.61; border-radius: 16px; overflow: hidden; background: repeating-linear-gradient(90deg, #ffffff0a 0 1px, transparent 1px 3px), linear-gradient(110deg, #555558, #252527 6%, #222224 89%, #4c4c50 97%, #18181a); border: 1px solid #88888b; box-shadow: inset 0 2px 1px #d0d0d1, inset 3px 0 3px #85858b, inset -4px -3px 3px #070708; }
  .lens-plate { position: absolute; left: 4%; right: 4%; top: 7%; height: 31%; border: 1px solid #69696e; border-radius: 8px; background: repeating-linear-gradient(0deg, #535354 0px, #555557 1px, #555557 2px, #505052 3px), linear-gradient(100deg, #fff3, transparent 30%, #0003);background-blend-mode: normal; box-shadow: inset 0 1px 1px #c6c6c9, 0 1px 2px #000a; }
  .zeiss { position: absolute; top: 17%; left: 4%; font: 13px/1.25 Arial, sans-serif; color: #deded8; text-shadow: 0 1px #444; text-align: left; }
  .zeiss small { display: block; font-size: 10px; margin-top: 4px; }
  .flash { position: absolute; left: 44%; top: 15%; width: 20%; height: 22%; border: 2px solid #252527; border-radius: 4px; background: repeating-linear-gradient(90deg, #d4d2c9 0 2px, #adada7 2px 3px); box-shadow: 0 0 0 1px #999; }
  .focus-lamp { position: absolute; left: 68%; top: 18%; width: 8px; height: 8px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #899486, #252d26 50%, #111); box-shadow: 0 0 0 2px #333, 0 0 0 3px #888; }
  .zoom-label { position: absolute; left: 43%; bottom: 15%; font: 8px/1 Arial, sans-serif; color: #c3c3bc; letter-spacing: .3px; }
  .lens-housing { position: absolute; top: 5%; right: 2%; width: 24%; height: 90%; border-radius: 7px; background: linear-gradient(135deg, #171719, #030304); box-shadow: inset 0 0 0 2px #444, 0 0 0 1px #777; display: grid; place-items: center; }
  .lens-ring { position: relative; height: 100%; max-width: 92%; aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; background: radial-gradient(circle, #000 0 40%, #3b3e3c 41%, #8a8d84 46%, #1b1d1c 50%, #1b1d1c 53%, #55584f 55%, #101112 60%, #101112 100%); box-shadow: 0 0 0 1px #000, 0 0 0 2px #77777a, 0 2px 3px 2px #000a; }
  .lens-knurl { position: absolute; inset: 0; border-radius: 50%; background: repeating-conic-gradient(#ffffff26 0 2deg, #0000 2deg 6deg); -webkit-mask: radial-gradient(circle, #0000 60%, #000 62% 100%); mask: radial-gradient(circle, #0000 60%, #000 62% 100%); }
  .lens-glass { position: relative; width: 56%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 50% 50%, #02030a 0 18%, #14123a 30%, #1d3a3b 44%, #0a1a14 58%, #3a1d52 72%, #050508 86%); box-shadow: inset 0 0 6px #000, 0 0 0 2px #0c0c0e, 0 0 0 3px #6a6d66; overflow: hidden; }
  .lens-glass::before { content: ""; position: absolute; left: 14%; top: 10%; width: 46%; height: 30%; border-radius: 50%; background: linear-gradient(160deg, #ffffffcc, #ffffff10 70%); transform: rotate(-28deg); filter: blur(.4px); }
  .lens-glass::after { content: ""; position: absolute; right: 18%; bottom: 16%; width: 18%; height: 18%; border-radius: 50%; background: radial-gradient(circle, #f6a8ffaa, #5cd6a244 55%, transparent 70%); }
  .zoom-lever { position: absolute; right: 7%; top: -4px; width: 54px; height: 14px; border: 1px solid #5c5c60; border-radius: 8px; background: linear-gradient(#e8e8ea, #8f8f93 50%, #d2d2d5); display: flex; justify-content: space-between; padding: 0 6px; box-shadow: 0 1px 1px #fff8 inset; }
  .zoom-lever i { font: 700 6px/12px Arial, sans-serif; color: #2a2a2d; }
  .mode-switch { position: absolute; left: 30%; top: 4px; width: 16px; height: 6px; border-radius: 3px; background: linear-gradient(#222, #555); box-shadow: 0 0 0 1px #888; }
  .mic { position: absolute; left: 36%; top: 22%; width: 3px; height: 3px; border-radius: 50%; background: #111; box-shadow: 0 0 0 1px #888a; }
  .screw { position: absolute; width: 5px; height: 5px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #cfcfd2, #6b6b70 60%, #38383b); box-shadow: 0 0 0 1px #2a2a2d; }
  .screw::after { content: ""; position: absolute; left: 1px; right: 1px; top: 2px; height: 1px; background: #222; transform: rotate(35deg); }
  .s1 { left: 2%; top: 10%; } .s2 { left: 2%; bottom: 10%; } .s3 { left: 71%; top: 8%; } .s4 { left: 71%; bottom: 8%; }
  .steady { position: absolute; left: 4%; bottom: 14%; font: italic 7px/1 Arial, sans-serif; color: #d8d8d2; letter-spacing: .4px; }
  .speaker { position: absolute; left: 6%; bottom: 8%; width: 20%; height: 10%; background: radial-gradient(circle, #000 0 1px, #0000 1.5px) 0 0/5px 5px; opacity: .85; }
  .strap-lug { position: absolute; right: 0; bottom: 14%; width: 6px; height: 14px; border-radius: 3px 0 0 3px; background: linear-gradient(90deg, #9a9a9e, #3a3a3d); box-shadow: inset 0 0 0 2px #111; }
  .spec { position: absolute; left: 6%; bottom: 3%; font: 5px/1 Arial, sans-serif; color: #7c7c80; letter-spacing: .6px; }
  .body-label { position: absolute; bottom: 10%; right: 8%; color: #969696; font: 7px Arial, sans-serif; letter-spacing: 1px; }
  .lens-cover { position: absolute; left: 2.5%; top: 7%; width: 95%; height: 91%; padding: 0; border: 1px solid #4c4c50; border-top-color: #a4a4a7; border-radius: 9px 9px 12px 12px; background: linear-gradient(105deg, #ffffff00 0 38%, #ffffff12 46%, #ffffff00 54%, #ffffff0c 78%, #ffffff00 86%), repeating-linear-gradient(90deg, #ffffff07 0 1px, #00000010 1px 2px), linear-gradient(110deg, #3d3d40 0%, #252527 18%, #1a1a1c 60%, #2a2a2d 97%); transform: translateY(calc(var(--open) * 33%)); transition: transform 300ms cubic-bezier(.22, 1, .36, 1); box-shadow: 0 -3px 5px #0007, inset 1px 1px 1px #69696c, inset -2px -2px 4px #09090a; color: #ddd; touch-action: none; cursor: ns-resize; user-select: none; -webkit-user-select: none; }
  .cover-edge { position: absolute; inset: 3px 6px auto; height: 1px; background: linear-gradient(90deg, transparent, #96969855, transparent); }
  .sony-logo { position: absolute; right: 18%; top: 40%; font: 600 32px/1 Georgia, serif; letter-spacing: -.8px; text-shadow: 0 1px 1px #000; color: #dedee0; }
  .cybershot-logo { position: absolute; left: 7%; bottom: 12%; font: 16px/1 Arial, sans-serif; letter-spacing: -.6px; color: #bebec2; }
  .cover-grip { position: absolute; right: 7%; top: 10%; width: 26px; height: 3px; border-radius: 2px; background: #373739; box-shadow: 0 1px 0 #555558; }
  .cover-rail { position: absolute; inset: 8px 8px 8px 8px; border: 1px solid #ffffff14; border-radius: 6px; box-shadow: inset 0 0 0 1px #00000070; pointer-events: none; }
  .cover-ridges { position: absolute; right: 5%; bottom: 8%; width: 22px; height: 30px; background: repeating-linear-gradient(0deg, #0a0a0b 0 2px, #5a5a5e 2px 3px); border-radius: 3px; opacity: .8; }
  .cover-zeiss { position: absolute; left: 7%; top: 12%; text-align: left; font: italic 11px/1.2 Georgia, serif; color: #cfcfca; letter-spacing: .3px; }
  .cover-zeiss small { display: block; font: 8px/1.4 Arial, sans-serif; letter-spacing: .4px; color: #9c9c98; }
  .cover-mp { position: absolute; right: 18%; top: 66%; font: 700 15px/1 Arial, sans-serif; color: #a8a8ac; text-align: right; }
  .cover-mp small { display: block; font: 600 6px/1.6 Arial, sans-serif; letter-spacing: 1.2px; }
  .cover-screw { position: absolute; width: 6px; height: 6px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #aaa, #55555a 60%, #2a2a2d); box-shadow: 0 0 0 1px #0a0a0b; }
  .cs1 { left: 3%; top: 5%; } .cs2 { right: 3%; top: 5%; }
  [data-dragging="true"] .lens-cover { transition: none; }
  .camera-body:has(.lens-cover:focus-visible), .camera-object:has(.cover-slider:focus-visible) { outline: 2px solid var(--accent); outline-offset: 6px; border-radius: 16px; }
  .cover-slider { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .camera-flip { position: relative; transform-style: preserve-3d; transform: perspective(1400px) rotateY(0); transition: transform 700ms cubic-bezier(.45, .05, .2, 1); }
  [data-flipped="true"] .camera-flip { transform: perspective(1400px) rotateY(180deg); }
  [data-flipped="true"] .explore-hint { opacity: 0; pointer-events: none; }
  .explore-hint { transition: opacity 300ms; }
  .camera-front { position: relative; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .camera-back { position: absolute; inset: 0; transform: rotateY(180deg); backface-visibility: hidden; -webkit-backface-visibility: hidden; container-type: size; border-radius: 16px; border: 1px solid #88888b; background: repeating-linear-gradient(90deg, #ffffff0a 0 1px, transparent 1px 3px), linear-gradient(250deg, #555558, #252527 6%, #222224 89%, #4c4c50 97%, #18181a); box-shadow: inset 0 2px 1px #d0d0d1, inset 3px 0 3px #85858b, inset -4px -3px 3px #070708; }
  .lcd { position: absolute; left: 3%; top: 7%; width: 72%; height: 86%; overflow: hidden; border-radius: 5px; background: #020203; box-shadow: 0 0 0 3px #08080a, 0 0 0 4px #77777b, inset 0 0 10px #000; }
  .lcd-album, .lcd figure { position: absolute; inset: 0; margin: 0; }
