---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  id?: string;
  note?: string;
  layout?: 'fan' | 'grid';
  items: { src: ImageMetadata; title: string; alt: string }[];
}
const { id = 'visual-studies', items, note, layout = 'fan' } = Astro.props;
if (!items.length || (layout === 'fan' && items.length !== 3)) throw new Error('ImageFan expects three images in a fan, or at least one in a grid.');
let portraitIndex = 0;
const galleryItems = items.map(item => {
  const landscape = item.src.width > item.src.height;
  const large = !landscape && [0, 3].includes(portraitIndex++ % 4);
  return { ...item, landscape, large };
});
---
<image-fan data-layout={layout}>
  <div class:list={['image-stage', layout === 'fan' ? 'fan-stage' : 'photo-grid']} role="group" aria-label="Image gallery">
    {galleryItems.map((item, index) => <a
      class:list={['image-link', layout === 'fan' ? 'fan-card' : 'photo-link', { landscape: item.landscape, 'photo-large': item.large }]}
      href={item.src.src}
      aria-label={`View ${item.title.toLowerCase()}`}
      data-image={item.src.src}
      data-title={item.title}
      data-alt={item.alt}
      data-width={item.src.width}
      data-height={item.src.height}
      style={`--position:${index - 1};--angle:${(index - 1) * 10}deg;--drop:${index === 1 ? 0 : 14}px;--order:${index};--layer:${index === 1 ? 2 : 1};--photo-ratio:${item.src.width}/${item.src.height}`}
    >
      <Image src={item.src} alt={item.alt} widths={layout === 'fan' ? [160, 320, 480] : [320, 480, 680, 960, 1360]} sizes={layout === 'fan' ? '(max-width: 600px) 112px, 176px' : item.landscape ? '(max-width: 728px) calc(100vw - 48px), 680px' : item.large ? '(max-width: 600px) calc(100vw - 48px), (max-width: 728px) 56vw, 387px' : '(max-width: 600px) calc(100vw - 48px), (max-width: 728px) 40vw, 269px'} loading={layout === 'grid' && index < 2 ? 'eager' : 'lazy'} />
      <span>{item.title}</span>
    </a>)}
  </div>
  <p class="fan-hint">Select a photo for a closer look.</p>
  <dialog aria-labelledby={`${id}-caption`}>
    <div class="lightbox-heading">
      <p id={`${id}-caption`} data-caption>{items[0].title}</p>
      <button type="button" data-close autofocus>Close</button>
    </div>
    <img data-full-image src={items[0].src.src} alt={items[0].alt} width={items[0].src.width} height={items[0].src.height} />
    {note && <p class="lightbox-note">{note}</p>}
  </dialog>
</image-fan>

<script>
  class ImageFan extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized) return;
      const dialog = this.querySelector<HTMLDialogElement>('dialog');
      const image = this.querySelector<HTMLImageElement>('[data-full-image]');
      const caption = this.querySelector<HTMLElement>('[data-caption]');
      if (!dialog || !image || !caption || typeof dialog.showModal !== 'function') return;
      this.dataset.initialized = 'true';
      this.querySelectorAll<HTMLAnchorElement>('.image-link').forEach(link => {
        link.addEventListener('click', event => {
          if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0) return;
          event.preventDefault();
          image.src = link.dataset.image ?? link.href;
          image.alt = link.dataset.alt ?? '';
          image.width = Number(link.dataset.width) || 600;
          image.height = Number(link.dataset.height) || 800;
          caption.textContent = link.dataset.title ?? '';
          dialog.showModal();
        });
      });
      this.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', event => {
        if (event.target === dialog) {
          const bounds = dialog.getBoundingClientRect();
          if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
        }
      });
      if (this.dataset.layout === 'fan' && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(entries => {
          if (entries.some(entry => entry.isIntersecting)) {
            this.classList.add('has-entered');
            observer.disconnect();
          }
        }, { threshold: 0.3 });
        observer.observe(this);
      }
    }
  }
  if (!customElements.get('image-fan')) customElements.define('image-fan', ImageFan);
</script>

<style>
  image-fan { display: block; }
  .photo-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--space-6); row-gap: var(--space-12); align-items: end; }
  .photo-link { display: block; grid-column: span 5; min-width: 0; text-decoration: none; }
  .photo-link.photo-large { grid-column: span 7; }
  .photo-link.landscape { grid-column: 1 / -1; }
  .photo-link img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 4px; }
  .photo-link.landscape img { aspect-ratio: var(--photo-ratio); }
  .photo-link span { display: block; padding-top: var(--space-3); color: var(--muted); font-size: var(--text-meta); line-height: 1.5; }
  .photo-link:is(:hover, :focus-visible) span { color: var(--accent); text-decoration: underline; text-underline-offset: .22em; }
  .photo-grid + .fan-hint { margin-top: var(--space-4); }
  .fan-stage {
    --card-width: clamp(92px, 25vw, 176px);
    --rest-spread: .72;
    --active-spread: .88;
    --spread: calc(var(--card-width) * var(--rest-spread));
    position: relative;
    height: calc(var(--card-width) * 1.5 + 80px);
    margin-top: var(--space-6);
  }
  .fan-card {
    position: absolute;
    top: 32px;
    left: 50%;
    z-index: var(--layer);
    width: var(--card-width);
    padding: 8px 8px 12px;
    border-radius: 12px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 8px 24px rgb(43 45 40 / .12);
    text-decoration: none;
    text-align: center;
    transform-origin: center 75%;
    transform: translateX(calc(-50% + var(--position) * var(--spread))) translateY(var(--drop)) rotate(var(--angle));
    transition: transform 400ms var(--ease-out), box-shadow 400ms var(--ease-out);
  }
  .fan-card img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 4px; }
  .fan-card span { display: block; margin-top: 8px; font-size: 12px; line-height: 1.5; }
  .fan-stage:has(.fan-card:is(:hover, :focus-visible)) { --spread: calc(var(--card-width) * var(--active-spread)); }
  .fan-card:is(:hover, :focus-visible) {
    z-index: 3;
    color: var(--ink);
    transform: translateX(calc(-50% + var(--position) * var(--spread))) translateY(-16px) rotate(0deg);
    box-shadow: 0 16px 32px rgb(43 45 40 / .16);
  }
  .fan-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  .fan-hint { color: var(--muted); font-size: var(--text-caption); text-align: center; margin-bottom: 0; }
  .has-entered .fan-card { animation: fan-unfold 650ms var(--ease-out) backwards; animation-delay: calc(var(--order) * 70ms); }
  @keyframes fan-unfold {
    from { transform: translateX(-50%) translateY(20px) rotate(0deg); }
  }
  dialog {
    width: min(560px, calc(100vw - 48px));
    max-height: calc(100dvh - 48px);
    padding: var(--space-6);
    border: 0;
    border-radius: 12px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 24px 80px rgb(43 45 40 / .2);
  }
  dialog::backdrop { background: rgb(30 33 28 / .5); }
  .lightbox-heading { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); margin-bottom: var(--space-4); }
  .lightbox-heading p { margin: 0; font-size: var(--text-small); font-weight: 500; }
  button { min-height: 44px; padding: 8px 0 8px 12px; border: 0; background: transparent; color: var(--muted); font: inherit; font-size: var(--text-meta); cursor: pointer; }
  button:hover { color: var(--accent); }
  button:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 2px; }
  [data-full-image] { display: block; max-width: 100%; max-height: min(65dvh, 640px); width: auto; height: auto; margin-inline: auto; border-radius: 4px; }
  .lightbox-note { color: var(--muted); font-size: var(--text-caption); text-align: center; margin: var(--space-4) 0 0; }
  @media (max-width: 600px) {
    .photo-grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-8); }
    .photo-link, .photo-link.photo-large, .photo-link.landscape { grid-column: auto; }
    .photo-link img { aspect-ratio: var(--photo-ratio); }
    .fan-stage { --card-width: clamp(82px, 25vw, 112px); --rest-spread: 1.12; --active-spread: 1.12; margin-top: var(--space-4); }
    dialog { padding: var(--space-4); }
  }
  @media (prefers-reduced-motion: reduce) {
    .fan-card { animation: none !important; transition: none !important; }
    .fan-stage:has(.fan-card:is(:hover, :focus-visible)) { --spread: calc(var(--card-width) * var(--rest-spread)); }
    .fan-card:is(:hover, :focus-visible) { transform: translateX(calc(-50% + var(--position) * var(--spread))) translateY(var(--drop)) rotate(var(--angle)); }
  }
</style>
