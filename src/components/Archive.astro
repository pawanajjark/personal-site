---
import PostList from './PostList.astro';
import type { Post } from '../lib/posts';
interface Props { posts: Post[] }
const { posts } = Astro.props;
const years = [...new Set(posts.map(post => post.data.date.getUTCFullYear()))];
---
{years.length ? years.map(year => <section class="year-group" aria-label={`Posts from ${year}`}><h2>{year}</h2><PostList posts={posts.filter(post => post.data.date.getUTCFullYear() === year)} descriptions /></section>) : <p class="muted">Nothing published here yet. More soon.</p>}
