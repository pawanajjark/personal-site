---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption?: string; wide?: boolean }
const { src, alt, caption, wide = false } = Astro.props;
---
<figure class:list={['media-figure', { wide }]}>
  <Image src={src} alt={alt} widths={[400, 720, 1100, 1440]} sizes={wide ? '(max-width: 760px) 100vw, 960px' : '(max-width: 760px) 100vw, 680px'} loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
