<p class="money-moment">
  <button type="button" class="money-trigger" aria-label="I have the money now. Play a little rupee-note animation">I have the money now.</button>{' '}
  I’m enjoying being able to do this for myself.
</p>

<script>
  document.querySelectorAll<HTMLButtonElement>('.money-trigger').forEach(button => {
    let playing = false;
    button.addEventListener('click', () => {
      if (playing || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      playing = true;
      const bounds = button.getBoundingClientRect();
      const layer = document.createElement('div');
      layer.className = 'rupee-flutter';
      layer.setAttribute('aria-hidden', 'true');
      document.body.append(layer);
      const animations = Array.from({ length: 5 }, (_, index) => {
        const note = document.createElement('span');
        note.className = 'rupee-note';
        note.textContent = '₹';
        const x = Math.max(24, Math.min(innerWidth - 56, bounds.left + bounds.width / 2 + (index - 2) * 35));
        const y = Math.max(24, Math.min(innerHeight - 180, bounds.top - 90));
        note.style.left = `${x}px`;
        note.style.top = `${y}px`;
        layer.append(note);
        const drift = index % 2 === 0 ? 18 : -18;
        const animation = note.animate([
          { opacity: 0, transform: `translate(0, 0) rotate(${drift}deg)` },
          { opacity: 0.75, transform: `translate(${-drift}px, 25px) rotate(${-drift}deg)`, offset: 0.2 },
          { opacity: 0.65, transform: `translate(${drift}px, 90px) rotate(${drift / 2}deg)`, offset: 0.65 },
          { opacity: 0, transform: `translate(0, 150px) rotate(${-drift}deg)` },
        ], { duration: 1600 + index * 90, delay: index * 100, easing: 'ease-in-out', fill: 'both' });
        return animation.finished;
      });
      Promise.allSettled(animations).then(() => {
        layer.remove();
        playing = false;
      });
    });
  });
</script>

<style>
  .money-trigger { padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: inherit; cursor: pointer; text-decoration: underline dotted; text-decoration-color: var(--muted); text-underline-offset: 5px; }
  .money-trigger:hover { text-decoration-color: var(--ink); }
  .money-trigger:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; border-radius: 2px; }
  :global(.rupee-flutter) { position: fixed; inset: 0; pointer-events: none; z-index: 100; overflow: hidden; }
  :global(.rupee-note) { position: absolute; display: grid; place-items: center; width: 42px; height: 23px; border: 1px solid #718466; border-radius: 2px; background: #c3cfad; color: #526348; box-shadow: inset 0 0 0 3px #c3cfad, inset 0 0 0 4px #93a382; font: 15px Georgia, serif; }
  @media (prefers-reduced-motion: reduce) {
    :global(.rupee-flutter) { display: none; }
  }
</style>
