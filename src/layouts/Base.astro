---
import { site } from '../site.config';
import '../styles/global.css';
interface Props { title?: string; description?: string; noindex?: boolean; type?: 'website' | 'article' }
const { title, description = site.description, noindex = false, type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
const configured = new URL(site.url).hostname !== 'example.com';
const shareImage = new URL('/og.jpg', site.url);
const nav = [{ label: 'Home', href: '/' }, { label: 'Writing', href: '/writing/' }, { label: 'Notes', href: '/notes/' }, { label: 'About', href: '/about/' }];
---
<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1d1a" media="(prefers-color-scheme: dark)" />
    <title>{title ? `${title} · ${site.name}` : site.title}</title>
    <meta name="description" content={description} />
    {(!configured || noindex || site.isPreview) && <meta name="robots" content="noindex, nofollow" />}
    {configured && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={type} />
    {configured && <><meta property="og:image" content={shareImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    {configured && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={site.name} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}'s writing`} href="/rss.xml" />
    <script is:inline>
      // Runs before paint so a saved theme never flashes the other one.
      (() => {
        const root = document.documentElement;
        let saved;
        try { saved = localStorage.getItem('theme'); } catch {}
        root.dataset.theme = saved === 'light' || saved === 'dark' ? saved : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const sync = () => {
          const dark = root.dataset.theme === 'dark';
          document.querySelector('[data-theme-toggle]')?.setAttribute('aria-pressed', String(dark));
          document.querySelectorAll('meta[name="theme-color"]').forEach(meta => { meta.content = dark ? '#1c1d1a' : '#faf9f6'; });
        };
        document.addEventListener('DOMContentLoaded', sync);
        document.addEventListener('click', event => {
          if (!event.target.closest?.('[data-theme-toggle]')) return;
          root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          try { localStorage.setItem('theme', root.dataset.theme); } catch {}
          sync();
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <header class="site-header">
        <a class="site-name" href="/">{site.name}<span class="name-dot" aria-hidden="true">.</span></a>
        <nav aria-label="Main navigation">
          {nav.map(({ label, href }) => <a href={href} aria-current={(href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href)) ? 'page' : undefined}>{label}</a>)}
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Dark mode" aria-pressed="false">
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.1A8.5 8.5 0 1 1 9.9 3.5a6.8 6.8 0 0 0 10.6 10.6Z" /></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg>
          </button>
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer">
        <span>Life, work, and things learned along the way.</span>
        <div><a href="/rss.xml">RSS</a>{site.links.map(link => <a href={link.href}>{link.label}</a>)}</div>
      </footer>
    </div>
  </body>
</html>
